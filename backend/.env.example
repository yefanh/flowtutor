# Copy to backend/.env and adjust. backend/.env is gitignored -- keys never get
# committed.

# Port 5433 matches the mapping in docker-compose.yml.
DATABASE_URL=postgresql://flowtutor:flowtutor@localhost:5433/flowtutor

# Where hints come from.
#
#   ollama  a model on this machine. No key, no quota, no rate limit, no
#           network. The default, because free-tier limits had become the
#           binding constraint three times over.
#             brew services start ollama && ollama pull qwen3.5:9b
#
#   google  Google AI Studio. Better sentences, but the free tier allows
#           15 requests per MINUTE on Flash-Lite and 20 per DAY on Flash.
#             https://aistudio.google.com -> Get API key
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:9b
OLLAMA_HOST=http://127.0.0.1:11434

# Only read when LLM_PROVIDER=google.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite

# Tokens the model may spend reasoning before answering. 0 is fastest; raise it
# if hint quality needs it (the eval will show whether it does).
LLM_THINKING_BUDGET=0

# Embeddings and reranking run locally regardless (bge-base, ms-marco), so
# retrieval never depends on any of the above.
