# Copy to backend/.env and fill in. backend/.env is gitignored -- keys never
# get committed.

# Port 5433 matches the mapping in docker-compose.yml.
DATABASE_URL=postgresql://flowtutor:flowtutor@localhost:5433/flowtutor

# Google AI Studio, for hint generation. Free tier, no credit card:
#   https://aistudio.google.com -> Get API key
GOOGLE_API_KEY=

# Which provider generates hints. The alternatives exist because free-tier
# terms change; swapping is a config change, not a code change.
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite

# Embeddings run locally (Qwen3-Embedding-0.6B), so there is no key for them.

# Tokens the model may spend reasoning before answering. 0 is fastest;
# raise it if hint quality needs it (the eval will show whether it does).
LLM_THINKING_BUDGET=0
